{
  "name": "timurlenk-turk-satranci-engine",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Public Timur chess Fairy-Stockfish fork rule validation harness.",
  "scripts": {
    "test": "npm run test:timur-rules",
    "test:movement": "node tests/timur-piece-movement-probe.js",
    "test:movement-edge": "node tests/timur-piece-edge-blocker-probe.js",
    "test:native-rules": "node tests/timur-native-rule-smoke.js",
    "test:app-parity": "node tests/timur-app-state-parity.js",
    "test:js-replay": "node tests/timur-js-match-replay.js",
    "test:timur-rules": "node tests/run-timur-rules.js",
    "test:wasm-ai": "npm run wasm-ai:smoke",
    "wasm-ai:smoke": "node scripts/run-wasm-ai-vs-ai.mjs --preset smoke --max-moves 80 --opening-plies 2",
    "wasm-ai:standard": "node scripts/run-wasm-ai-vs-ai.mjs --preset standard --max-moves 280 --opening-plies 2",
    "wasm-ai:full": "node scripts/run-wasm-ai-vs-ai.mjs --preset full --max-moves 280 --opening-plies 3"
  }
}
